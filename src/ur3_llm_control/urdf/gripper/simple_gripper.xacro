<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================
       GRIPPER BASE
       ========================= -->

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
      <material name="gripper_black">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia
        ixx="0.0002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0002"
        iyz="0.0"
        izz="0.0002"/>
    </inertial>
  </link>


  <!-- =========================
       LEFT FINGER
       ========================= -->

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.09"/>
      </geometry>
      <material name="finger_left">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.09"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00005"
        iyz="0.0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>

    <origin xyz="0 0.035 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

    <limit
      lower="0.0"
      upper="0.045"
      effort="20"
      velocity="0.2"/>
  </joint>


  <!-- =========================
       RIGHT FINGER
       ========================= -->

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.09"/>
      </geometry>
      <material name="finger_right">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.09"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00005"
        iyz="0.0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>

    <origin xyz="0 -0.035 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>

    <limit
      lower="0.0"
      upper="0.045"
      effort="20"
      velocity="0.2"/>
  </joint>


  <!-- =========================
       GAZEBO CONTACT
       ========================= -->

  <gazebo reference="left_finger_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="right_finger_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

</robot>
